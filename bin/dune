(executable
 (name pq_save_tool)
 (libraries puzzle_quest_lib))

(executable
 (name pq_battle)
 (libraries puzzle_quest_lib))

(executable
 (name pq_play)
 (libraries puzzle_quest_lib))

; The graphics front. sdl3 is a pinned git dependency (see README), and it binds
; 40 of the 42 SDL3 calls a board renderer needs; see tools/sdl3_readiness.md.
(executable
 (name sdl3_probe)
 (libraries sdl3))

; The graphics front, phase 1: SDL2's own 2D renderer, no OpenGL yet. SDL picks
; the backend per platform - OpenGL on desktop, OpenGL ES on Android - which is
; the whole reason for not writing GL directly yet. See tools/graphics_plan.md.
(executable
 (name sdl2_probe)
 (libraries tsdl))

; SDL2 for the window and input, tgls for OpenGL. tgls binds GL 3/4 and GLES 2/3,
; so the same dependency covers desktop and Android; see tools/graphics_plan.md.
(executable
 (name gl_probe)
 (libraries tsdl tgls.tgl3))

; The windowed battle: the same Battle the ASCII runner drives, with the human's
; two choices made by mouse rather than by read_line.
(executable
 (name pq_play_gfx)
 (libraries puzzle_quest_lib pq_gfx tsdl))
